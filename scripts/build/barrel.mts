// Builds src/index.ts (the root barrel) from the exports of src/components/*.tsx.
// Each component gets its import, its re-export, its exported types, and a
// `XProps = ComponentProps<typeof X>` alias for every PascalCase value.
//
// Run: pnpm index          (rewrite src/index.ts)
//      pnpm index:check    (exit 1 when src/index.ts is out of date)
import { readdirSync, readFileSync, writeFileSync } from "node:fs"
import { format, resolveConfig } from "prettier"

// Subpath-only components: kept out of the root barrel.
// sonner: optional peer dep, and its Toaster clashes with toast's Toaster.
const SUBPATH_ONLY = new Set(["sonner"])

export type ComponentExports = { values: string[]; types: string[] }

// Reads the names a component file exports. Covers `export { A, type B }`,
// `export type X =`, `export interface X`, and `export function/const X`.
export function parseExports(code: string): ComponentExports {
  const values: string[] = []
  const types: string[] = []
  for (const [, list] of code.matchAll(/^export\s*\{([^}]*)\}/gm)) {
    for (const raw of list.split(",")) {
      const name = raw.trim()
      if (!name) continue
      if (name.includes(" as ")) {
        throw new Error(`Renamed export not supported: "${name}"`)
      }
      if (name.startsWith("type ")) types.push(name.slice(5).trim())
      else values.push(name)
    }
  }
  for (const [, name] of code.matchAll(
    /^export\s+(?:type|interface)\s+(\w+)/gm
  )) {
    types.push(name)
  }
  for (const [, name] of code.matchAll(
    /^export\s+(?:async\s+)?(?:function|const|let|class)\s+(\w+)/gm
  )) {
    values.push(name)
  }
  return { values, types }
}

// Returns the unformatted barrel source for the given components.
export function buildIndex(
  components: { name: string; exports: ComponentExports }[]
): string {
  const blocks = components.map(({ name, exports: { values, types } }) => {
    const from = `"./components/${name}"`
    const lines: string[] = []
    if (values.length) {
      lines.push(`import { ${values.join(", ")} } from ${from}`)
      lines.push(`export { ${values.join(", ")} }`)
    }
    if (types.length)
      lines.push(`export type { ${types.join(", ")} } from ${from}`)
    for (const value of values) {
      const props = `${value}Props`
      if (/^[A-Z]/.test(value) && !types.includes(props)) {
        lines.push(`export type ${props} = ComponentProps<typeof ${value}>`)
      }
    }
    return lines.join("\n")
  })
  return [
    "// Generated by scripts/build/barrel.mts. Do not edit; run `pnpm index`.",
    `import type { ComponentProps } from "react"`,
    ...blocks,
  ].join("\n\n")
}

if (import.meta.main) {
  const dir = "src/components"
  const components = readdirSync(dir)
    .filter((file) => file.endsWith(".tsx"))
    .map((file) => file.slice(0, -4))
    .filter((name) => !SUBPATH_ONLY.has(name))
    .sort()
    .map((name) => ({
      name,
      exports: parseExports(readFileSync(`${dir}/${name}.tsx`, "utf8")),
    }))

  const target = "src/index.ts"
  const output = await format(buildIndex(components), {
    ...(await resolveConfig(target)),
    filepath: target,
  })

  if (process.argv.includes("--check")) {
    if (readFileSync(target, "utf8") !== output) {
      console.error(`${target} is out of date. Run: pnpm index`)
      process.exit(1)
    }
  } else {
    writeFileSync(target, output)
  }
}
