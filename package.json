{
  "name": "@asif-sirajudeen/earth-ui",
  "version": "0.4.0",
  "description": "shadcn-based React components on Base UI, shipped as a versioned package.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asif-sirajudeen/earth-ui.git"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "earth-ui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./use-highlighted-code": {
      "types": "./dist/hooks/use-highlighted-code.d.ts",
      "default": "./dist/hooks/use-highlighted-code.js"
    },
    "./use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsdown && node scripts/build-props.mts && node scripts/build-examples.mts && shadcn build --output dist/registry",
    "registry": "node scripts/build-registry.mts && shadcn registry validate && shadcn build",
    "registry:check": "node scripts/build-registry.mts && git diff --exit-code registry.json",
    "index": "node scripts/build-index.mts",
    "index:check": "node scripts/build-index.mts --check",
    "links:check": "node scripts/check-links.mts",
    "registry:smoke": "node scripts/smoke-registry.mts",
    "package:smoke": "node scripts/smoke-package.mts",
    "upstream:check": "node scripts/upstream-check.mts",
    "upstream:ledger": "node scripts/upstream-ledger.mts",
    "test": "node --test scripts/*.test.mts 'cli/test/**/*.test.mts'",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "format:write": "prettier --write \"**/*.{ts,tsx,mts,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mdx}\" --cache"
  },
  "peerDependencies": {
    "next-themes": "~0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "next-themes": "~0.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tsdown": "^0.23.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "~0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "~0.5.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.18.1",
    "recharts": "~3.8.0",
    "tw-animate-css": "^1.4.0"
  }
}
